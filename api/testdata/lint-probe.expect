# Expected koala-* results of api/testdata/lint-probe.yaml: one line per
# (rule, JSON path) pair, tab-separated. scripts/api-lint-probe.sh fails on
# a missing or an unexpected pair.
# koala-operation-authz is a oneOf whose branches use `not`: when a case
# breaks a `not`, vacuum v0.36.2 reports it once at the operation and once
# at its path item, so those cases have two lines.
koala-admin-only-under-admin	$.paths['/v1/permission-outside-admin'].get
koala-admin-permission	$.paths['/v1/admin/users'].get
koala-body-limit	$.paths['/v1/body-limit'].post
koala-bps-integer	$.components.schemas['BpsNotInteger'].properties['feeBps']
koala-bps-integer	$.components.schemas['BpsNotIntegerNullable'].properties['rentBps']
koala-calendar-date-is-date	$.components.schemas['DateNotDate'].properties['birthDate']
koala-closed-request-body	$.paths['/v1/all-of-open-member'].post.requestBody.content['application/json'].schema.allOf[0].properties['inner']
koala-closed-request-body	$.paths['/v1/all-of-without-unevaluated'].post.requestBody.content['application/json'].schema
koala-closed-request-body	$.paths['/v1/open-body'].post.requestBody.content['application/json'].schema
koala-closed-request-body	$.paths['/v1/open-nested'].post.requestBody.content['application/json'].schema.properties['branch'].oneOf[0]
koala-closed-request-body	$.paths['/v1/open-nested'].post.requestBody.content['application/json'].schema.properties['list'].items
koala-closed-request-body	$.paths['/v1/open-nested'].post.requestBody.content['application/json'].schema.properties['nested']
koala-cursor-pagination	$.paths['/v1/page-param'].get.parameters[0].schema.name
koala-default-problem-response	$.paths['/v1/no-default'].get.responses
koala-deprecation-has-sunset	$.paths['/v1/deprecated'].get
koala-enum-upper-snake	$.components.schemas['LowerEnum'].properties['state']
koala-enum-upper-snake	$.components.schemas['LowerEnumNullable'].properties['state']
koala-error-responses-are-problems	$.paths['/v1/error-not-problem'].get.responses['404']
koala-error-responses-are-problems	$.paths['/v1/error-without-content'].get.responses['409']
koala-idempotency-key	$.paths['/v1/no-idempotency'].post
koala-include-total-admin-or-seo	$.paths['/v1/include-total'].get
koala-instant-is-date-time	$.components.schemas['InstantNotDateTime'].properties['createdAt']
koala-integer-format	$.components.schemas['NoFormat'].properties['count']
koala-integer-format	$.components.schemas['NoFormatNullable'].properties['count']
koala-merge-patch-nullable	$.paths['/v1/patch-nullable'].patch.requestBody.content['application/merge-patch+json'].schema.properties['amount']
koala-merge-patch-nullable	$.paths['/v1/patch-nullable'].patch.requestBody.content['application/merge-patch+json'].schema.properties['nested'].properties['label']
koala-merge-patch-nullable	$.paths['/v1/patch-nullable'].patch.requestBody.content['application/merge-patch+json'].schema.properties['note']
koala-merge-patch-shape	$.paths['/v1/patch-required'].patch.requestBody.content['application/merge-patch+json'].schema
koala-money-is-money	$.components.schemas['MoneyAsNullableInteger'].properties['refundAmount']
koala-money-is-money	$.components.schemas['MoneyAsNullableNumber'].properties['wage']
koala-money-is-money	$.components.schemas['MoneyAsNumber'].properties['price']
koala-no-envelope	$.paths['/v1/envelope-in-all-of'].get.responses['200'].content['application/json'].schema.allOf[0].properties.httpStatus
koala-no-envelope	$.paths['/v1/envelope-message'].get.responses['200'].content['application/json'].schema.properties.message
koala-no-envelope	$.paths['/v1/envelope-success'].get.responses['200'].content['application/json'].schema.properties.success
koala-no-multipart-upload	$.paths['/v1/multipart'].post.requestBody.content['multipart/form-data']
koala-no-nullable-keyword	$.components.schemas['NullableKeyword'].properties['legacy']
koala-operation-authz	$.paths['/v1/authz-exempt-and-authz']
koala-operation-authz	$.paths['/v1/authz-exempt-and-authz'].get
koala-operation-authz	$.paths['/v1/authz-exempt-public']
koala-operation-authz	$.paths['/v1/authz-exempt-public'].get
koala-operation-authz	$.paths['/v1/authz-exempt-short']
koala-operation-authz	$.paths['/v1/authz-exempt-short'].get
koala-operation-authz	$.paths['/v1/authz-not-a-relation']
koala-operation-authz	$.paths['/v1/authz-not-a-relation'].get
koala-operation-authz	$.paths['/v1/no-authz'].get
koala-operation-id-camel-case	$.paths['/v1/bad-operation-id'].get
koala-patch-is-merge-patch	$.paths['/v1/patch-json'].patch.requestBody.content
koala-paths-kebab-case	$.paths['/v1/Bad_Path']
koala-paths-v1	$.paths['/v2/things']
koala-properties-camel-case	$.components.schemas.SnakeCase.properties.snake_case_field
koala-rate-in-basis-points	$.components.schemas['RateNotBps'].properties['commissionRate']
koala-rate-in-basis-points	$.components.schemas['RateNotBpsNullable'].properties['successRate']
koala-sort-fields	$.paths['/v1/sort'].get
